{
  "name": "dofurs-single-page-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DISABLE_WEBPACK_CACHE=1 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "images:webp:audit": "node scripts/optimize-public-images.mjs --mode=audit",
    "images:webp:convert": "node scripts/optimize-public-images.mjs --mode=convert",
    "images:webp:audit:all": "node scripts/optimize-public-images.mjs --mode=audit --includeAll",
    "images:webp:convert:all": "node scripts/optimize-public-images.mjs --mode=convert --includeAll",
    "test:billing": "vitest run lib/payments/invoiceDetails.contract.test.ts lib/payments/invoiceService.test.ts app/api/admin/billing/invoices/__tests__/route.test.ts",
    "graphify:rebuild": "npx graphify hook-rebuild",
    "graphify:watch": "npx graphify watch .",
    "graphify:query": "npx graphify query",
    "test:schema-health": "node scripts/smoke-test-schema-health.mjs",
    "db:migrate": "node scripts/supabase-migrations.mjs apply",
    "db:migrate:status": "node scripts/supabase-migrations.mjs status",
    "db:types": "node scripts/generate-supabase-types.mjs",
    "cleanup:billing-automation-runs": "node scripts/cleanup-billing-automation-runs.mjs",
    "cleanup:booking-addresses": "node scripts/cleanup-booking-addresses.mjs",
    "audit:subscription-credits": "node scripts/audit-subscription-credit-bookings.mjs",
    "audit:service-catalog-sync": "node scripts/audit-service-catalog-sync-risk.mjs",
    "test:load:core": "node scripts/load-test-core-flows.mjs",
    "release:gate": "node scripts/release-readiness-gate.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.98.0",
    "browser-image-compression": "^2.0.2",
    "critters": "^0.0.23",
    "framer-motion": "^11.11.17",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "next": "^15.5.12",
    "razorpay": "^2.9.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.71.2",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.5.12",
    "graphifyy": "^0.3.28",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  }
